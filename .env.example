# Backend URLs used by the frontend (see shared/constants.ts).
#
# Defaults:
#   development -> http://localhost:8000
#   production  -> https://132.145.109.45
#
# Only set these if you need to override the defaults (e.g. phone testing on
# your LAN, or pointing a local build at the hosted server).
#
# For local dev, copy this file to `.env.development.local` (gitignored) and
# uncomment what you need:
#
# NEXT_PUBLIC_SOCKET_URL=http://localhost:8000/ws
# NEXT_PUBLIC_CREATE_ROOM_ENDPOINT=http://localhost:8000/rooms/create
# NEXT_PUBLIC_GET_SONG_ENDPOINT=http://localhost:8000/songs
